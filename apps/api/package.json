{
  "name": "@barberhub/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsc -p tsconfig.test.json && node ../../work/tests/test/policy.test.js && node ../../work/tests/test/integration.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.0",
    "bullmq": "^5.40.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "luxon": "^3.5.0",
    "multer": "^2.0.0",
    "pdfkit": "^0.16.0",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.8",
    "prisma": "6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
