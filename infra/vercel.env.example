# Configure these in Vercel, never commit real credentials.
# Runtime role must be barberhub_app without SUPERUSER/BYPASSRLS.
DATABASE_URL=postgresql://barberhub_app:REPLACE@MANAGED_POSTGRES_HOST:5432/barberhub?sslmode=require&connection_limit=3
REDIS_URL=rediss://default:REPLACE@MANAGED_REDIS_HOST:6379
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WEB_ORIGIN=https://REPLACE_WITH_PROJECT_DOMAIN
NOTIFICATIONS_MODE=external
WHATSAPP_PROVIDER=disabled
ENABLE_SWAGGER=false
LOG_LEVEL=info
PROXY_HOPS=1
# Optional, needed only to enable Google Identity Services.
GOOGLE_CLIENT_ID=
