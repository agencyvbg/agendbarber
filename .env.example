# Copy to .env; replace EVERY password before deploying.
POSTGRES_PASSWORD=replace-with-database-owner-password
APP_DB_PASSWORD=replace-with-runtime-database-password
DATABASE_URL=postgresql://barberhub_app:replace-with-runtime-database-password@localhost:5432/barberhub
MIGRATION_DATABASE_URL=postgresql://barberhub:replace-with-database-owner-password@localhost:5432/barberhub
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
REDIS_PASSWORD=replace-with-redis-password
REDIS_URL=redis://:replace-with-redis-password@localhost:6379
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080
# OAuth Web Client ID from Google Cloud; leave blank to keep Google disabled.
GOOGLE_CLIENT_ID=
PORT=3000
ENABLE_SWAGGER=true
LOG_LEVEL=info
PROXY_HOPS=0
UPLOAD_DIR=uploads
SEED_PASSWORD=replace-with-initial-password-minimum-12
WHATSAPP_PROVIDER=disabled
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATES={}
